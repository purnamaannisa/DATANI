<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.datani.controller.petugas.PetugasSidebarController"
      styleClass="sidebar" prefWidth="230" spacing="4">
    <padding>
        <Insets top="24" right="12" bottom="24" left="12"/>
    </padding>

    <Label text="DATANI" styleClass="sidebar-brand"/>
    <Label text="Panel Petugas BPP" styleClass="sidebar-brand-sub"/>

    <VBox alignment="CENTER_LEFT" spacing="2" styleClass="sidebar-user-box">
        <Label fx:id="userNameLabel" text="Petugas" styleClass="sidebar-user-name"/>
        <Label fx:id="userRoleLabel" text="Petugas BPP" styleClass="sidebar-user-role"/>
    </VBox>

    <Separator/>

    <Button text="Beranda (Dashboard)" maxWidth="Infinity" styleClass="sidebar-button" onAction="#goToDashboard"/>
    <Button text="Verifikasi Pengajuan" maxWidth="Infinity" styleClass="sidebar-button" onAction="#goToVerifikasiPengajuan"/>
    <Button text="Verifikasi Gagal Panen" maxWidth="Infinity" styleClass="sidebar-button" onAction="#goToVerifikasiLaporan"/>
    <Button text="Hasil Verifikasi" maxWidth="Infinity" styleClass="sidebar-button" onAction="#goToHasilVerifikasi"/>
    <Button text="Profil" maxWidth="Infinity" styleClass="sidebar-button" onAction="#goToProfil"/>

    <VBox VBox.vgrow="ALWAYS"/>

    <Separator/>
    <Button text="Logout" maxWidth="Infinity" styleClass="sidebar-button,sidebar-logout" onAction="#handleLogout"/>
</VBox>
