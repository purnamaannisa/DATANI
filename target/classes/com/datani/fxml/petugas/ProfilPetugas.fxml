<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.datani.controller.petugas.ProfilPetugasController"
            styleClass="app-root">
    <left>
        <fx:include source="PetugasSidebar.fxml"/>
    </left>
    <top>
        <fx:include source="../common/HeaderBar.fxml"/>
    </top>
    <center>
        <VBox spacing="16" styleClass="content-area">
            <padding>
                <Insets top="28" right="32" bottom="28" left="32"/>
            </padding>

            <Label text="Profil" styleClass="page-title"/>
            <Label text="Kelola data akun Petugas BPP Anda." styleClass="page-subtitle"/>

            <VBox spacing="14" maxWidth="Infinity" styleClass="profile-card">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <VBox spacing="4">
                    <Label text="Username" styleClass="field-label"/>
                    <Label fx:id="usernameLabel" styleClass="field-readonly"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Nama Lengkap" styleClass="field-label"/>
                    <TextField fx:id="namaLengkapField" editable="false" styleClass="input-field"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Email" styleClass="field-label"/>
                    <TextField fx:id="emailField" editable="false" styleClass="input-field"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Nomor HP" styleClass="field-label"/>
                    <TextField fx:id="nomorHPField" editable="false" styleClass="input-field"/>
                </VBox>

                <Button fx:id="editProfilButton" text="Edit Profil" styleClass="primary-button" onAction="#handleEditProfil"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
