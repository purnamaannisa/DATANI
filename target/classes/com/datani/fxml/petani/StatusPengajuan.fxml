<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.datani.controller.petani.StatusPengajuanController"
            styleClass="app-root">
    <left>
        <fx:include source="PetaniSidebar.fxml"/>
    </left>
    <top>
        <fx:include source="../common/HeaderBar.fxml"/>
    </top>
    <center>
        <VBox spacing="16" styleClass="content-area">
            <padding>
                <Insets top="28" right="32" bottom="28" left="32"/>
            </padding>

            <Label text="Status Pengajuan" styleClass="page-title"/>
            <Label fx:id="subtitleLabel" text="Menampilkan pengajuan Anda" styleClass="page-subtitle"/>

            <javafx.scene.control.TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE" styleClass="login-tabpane">
                <javafx.scene.control.Tab text="Pupuk Subsidi">
                    <TableView fx:id="statusTable" styleClass="data-table">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="idColumn" text="ID Pengajuan" prefWidth="100"/>
                            <TableColumn fx:id="tanggalColumn" text="Tanggal Pengajuan" prefWidth="140"/>
                            <TableColumn fx:id="luasLahanColumn" text="Luas Lahan" prefWidth="100"/>
                            <TableColumn fx:id="jenisTanamanColumn" text="Jenis Tanaman" prefWidth="130"/>
                            <TableColumn fx:id="statusKepemilikanColumn" text="Status Kepemilikan" prefWidth="150"/>
                            <TableColumn fx:id="statusColumn" text="Status Verifikasi" prefWidth="150"/>
                            <TableColumn fx:id="detailColumn" text="Detail" prefWidth="120"/>
                        </columns>
                    </TableView>
                </javafx.scene.control.Tab>
                <javafx.scene.control.Tab text="Laporan Gagal Panen">
                    <TableView fx:id="gagalPanenTable" styleClass="data-table">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="gpIdColumn" text="ID Laporan" prefWidth="100"/>
                            <TableColumn fx:id="gpTanggalColumn" text="Tanggal Lapor" prefWidth="140"/>
                            <TableColumn fx:id="gpKerusakanColumn" text="Tingkat Kerusakan" prefWidth="150"/>
                            <TableColumn fx:id="gpStatusColumn" text="Status Verifikasi" prefWidth="150"/>
                            <TableColumn fx:id="gpDetailColumn" text="Detail" prefWidth="120"/>
                        </columns>
                    </TableView>
                </javafx.scene.control.Tab>
            </javafx.scene.control.TabPane>
        </VBox>
    </center>
</BorderPane>
