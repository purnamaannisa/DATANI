<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.datani.controller.petani.PetaniSidebarController"
      styleClass="sidebar" prefWidth="230" spacing="4">
    <padding>
        <Insets top="34" right="12" bottom="24" left="12"/>
    </padding>

    <Label text="DATANI" styleClass="sidebar-brand"/>
    <Label text="Sistem Informasi Pengajuan Data Petani" styleClass="sidebar-brand-sub" wrapText="true"/>

    <VBox alignment="CENTER_LEFT" spacing="2" styleClass="sidebar-user-box">
        <Label fx:id="userNameLabel" text="Petani" styleClass="sidebar-user-name"/>
        <Label fx:id="userRoleLabel" text="Petani" styleClass="sidebar-user-role"/>
    </VBox>

    <Separator/>

    <Button fx:id="btnDashboard" text="Beranda Petani" maxWidth="Infinity" styleClass="sidebar-button" onAction="#goToDashboard"/>
    <Button fx:id="btnPengajuan" text="Pengajuan Pupuk Subsidi" maxWidth="Infinity" styleClass="sidebar-button" onAction="#goToPengajuanPupuk"/>
    <Button fx:id="btnLapor" text="Lapor Gagal Panen" maxWidth="Infinity" styleClass="sidebar-button" onAction="#goToLaporGagalPanen"/>
    <Button fx:id="btnStatus" text="Status Pengajuan" maxWidth="Infinity" styleClass="sidebar-button" onAction="#goToStatusPengajuan"/>
    <Button fx:id="btnProfil" text="Profil" maxWidth="Infinity" styleClass="sidebar-button" onAction="#goToProfil"/>

    <VBox VBox.vgrow="ALWAYS"/>

    <Separator/>
    <Button text="Logout" maxWidth="Infinity" styleClass="sidebar-button,sidebar-logout" onAction="#handleLogout"/>
</VBox>
